# ==============================================================
#  APPLICATION
# --------------------------------------------------------------
#  LOCAL DEV : APP_ENV=local        APP_DEBUG=true
#  PRODUCTION: APP_ENV=production   APP_DEBUG=false   <-- REQUIRED
#
#  APP_DEBUG=true on a live site shows full stack traces (and
#  database credentials) to anyone who triggers an error. It MUST
#  be false on Hostinger.
#
#  APP_URL must be the real domain, including https://, with NO
#  trailing slash. Password-reset links and asset() URLs are
#  built from it.
#
#  Generate APP_KEY once with:  php artisan key:generate
# ==============================================================
APP_NAME="Peachy Cakes and Deli Cafe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Philippines local time. Order timestamps, sales reports and
# password-reset expiry all read from this.
APP_TIMEZONE=Asia/Manila
APP_URL=http://127.0.0.1:8000
# PRODUCTION EXAMPLE:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-real-domain.com

# ==============================================================
#  HTTPS  (set these on deploy day, AFTER the certificate is live)
# --------------------------------------------------------------
#  FORCE_HTTPS makes url(), route() and asset() always emit
#  https:// links, even if PHP itself cannot tell the request was
#  secure. Without it, a site behind a TLS-terminating proxy
#  serves https pages full of http:// asset links, and the browser
#  blocks them as mixed content.
#
#  SESSION_SECURE_COOKIE=true tells the browser never to send the
#  login cookie over plain http. Leave it FALSE locally: on
#  http://127.0.0.1 a secure cookie is simply never sent back, and
#  login will silently fail with no error message.
#
#  ORDER OF OPERATIONS on deploy day:
#    1. Deploy with both of these still false.
#    2. Confirm https://your-domain loads with a valid padlock.
#    3. Only then set both to true and run: php artisan config:clear
#
#  PRODUCTION VALUES:
#    FORCE_HTTPS=true
#    SESSION_SECURE_COOKIE=true
# ==============================================================
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
# 'lax' lets the session survive a normal click-through from an
# external link (e.g. a QR code opened from a messaging app) while
# still blocking cross-site form posts. Do not set this to 'none'.
SESSION_SAME_SITE=lax

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: use LOG_LEVEL=error. At 'debug' the log grows fast and
# records far more about each request than a live site should keep.
# LOG_STACK=daily also keeps it rotated instead of one endless file.
LOG_LEVEL=debug

# ==============================================================
#  DATABASE  (this project uses MySQL, not sqlite)
# --------------------------------------------------------------
#  On Hostinger, create the database in hPanel > Databases, then
#  paste the generated name / user / password below. The host
#  usually stays localhost.
# ==============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pomida_db
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================
#  FIRST ADMIN ACCOUNT
# --------------------------------------------------------------
#  There is no public admin registration. The very first admin is
#  created from these two values by:
#
#      php artisan db:seed --class=AdminBootstrapSeeder
#
#  Use a real password (8+ chars). After the account exists and
#  you have logged in once, blank these two lines again so the
#  password is not sitting in a file on the server.
# ==============================================================
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME="Site Admin"

SESSION_DRIVER=database
# 8 hours — one counter shift. See config/session.php for why.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploaded images (menu items, categories, ads) are written directly
# into public/uploads/. GCash QR + PWD/Senior ID uploads use the
# "public" storage disk and therefore need the public/storage
# symlink -> run  php artisan storage:link  after deploying.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================
#  MAIL  ***REQUIRED FOR "FORGOT PASSWORD" TO WORK***
# --------------------------------------------------------------
#  MAIL_MAILER=log does NOT send anything. It only writes the
#  message into storage/logs/laravel.log. That is fine for local
#  development, but on the live site it means a customer or admin
#  who clicks "Forgot Password" will NEVER receive their code.
#
#  On production you MUST set MAIL_MAILER=smtp and fill in real
#  credentials below.
#
#  ---- Gmail App Password (free, fastest) ----------------------
#   1. The Gmail account needs 2-Step Verification turned ON.
#      Google Account > Security > 2-Step Verification.
#   2. Go to Google Account > Security > App passwords
#      (https://myaccount.google.com/apppasswords)
#   3. Give it a name like "POMIDA" and click Create.
#   4. Google shows a 16-character code, e.g. "abcd efgh ijkl mnop".
#   5. Paste it into MAIL_PASSWORD *without the spaces*.
#      This is NOT the normal Gmail login password.
#   6. Put the same Gmail address in MAIL_USERNAME and
#      MAIL_FROM_ADDRESS.
#   7. Run:  php artisan config:clear
#
#  NOTE: never commit the real App Password to git.
# ==============================================================
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-gmail-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
#
# PRODUCTION: change the line above to  MAIL_MAILER=smtp
# (Hostinger email instead of Gmail? Use:
#    MAIL_HOST=smtp.hostinger.com
#    MAIL_PORT=465
#    MAIL_ENCRYPTION=ssl
#  with the mailbox you created in hPanel > Emails.)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Auto-generate demonstration sales history for the Admin Analytics Sales
# Forecast when real coverage is too thin to render a chart. FABRICATES ORDERS.
# Leave false/unset everywhere except a local demo machine; it additionally
# requires APP_ENV=local before it will write anything.
DEMO_SALES_AUTO_TOPUP=false
