# ══════════════════════════════════════════════════════════════════════
#  POMIDA — .env for the LIVE Hostinger server
# ══════════════════════════════════════════════════════════════════════
#
#  HOW TO USE THIS FILE
#
#    1. Copy it to a file named exactly  .env  in the project root
#       (the folder that contains the "artisan" file).
#    2. Replace every value written as FILL_IN_... with a real value.
#       The comment on each line says exactly where to get it.
#    3. Save, then run:   php artisan config:clear
#    4. Then run:         php artisan deploy:check
#       Proceed only if it prints READY TO GO LIVE.
#
#  Lines WITHOUT a FILL_IN_ placeholder are already correct for the live
#  server. Do not change them unless deploy:check tells you to.
#
#  ────────────────────────────────────────────────────────────────────
#  NEVER SHARE THE FILLED-IN VERSION OF THIS FILE
#
#  Once you fill in the values below, this file contains your database
#  password, your mailbox password and your APP_KEY. Anyone who reads it
#  can take over the site and read every customer record.
#
#  So: do not paste it into an AI assistant, a chat, a forum, a support
#  ticket, or a screenshot. Do not commit it to GitHub.
#
#  If you need help, share the SETTING NAMES and the placeholder text
#  from this example file (for example: "my MAIL_PASSWORD is not
#  working"). That is enough for anyone to help you, and it gives away
#  nothing.
#  ────────────────────────────────────────────────────────────────────
# ══════════════════════════════════════════════════════════════════════


# ══════════════ APPLICATION ══════════════

APP_NAME="POMIDA"

# MUST be exactly "production" on the live server.
# Leaving this as "local" is half of the condition that prints password
# reset codes on screen — see the MAIL_MAILER note below.
APP_ENV=production

# MUST be false. When true, any error page shows your database password
# and server file paths to whoever triggered the error.
APP_DEBUG=false

# FILL_IN — generate this ON THE SERVER, do not copy it from anywhere:
#     php artisan key:generate
# That command writes the value into .env for you, so you can leave this
# line exactly as it is until you run it.
APP_KEY=

# FILL_IN — your real domain, from hPanel > Websites.
# Must start with https:// and must NOT end with a slash.
# This is what password-reset links AND the printed table QR codes are
# built from, so getting it wrong means reprinting every table card.
APP_URL=https://FILL_IN_YOUR_DOMAIN.com

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12


# ══════════════ HTTPS ══════════════
#
# Turn BOTH of these on only AFTER https://your-domain loads in a browser
# with a padlock. Turning them on before the certificate works produces
# links the browser refuses to load.
#
# Start with both false, confirm the padlock, then set both to true and
# run: php artisan config:clear
#
# deploy:check will report FAIL until both are true. That is intentional
# — the site is not finished until they are.

FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax


# ══════════════ LOGGING ══════════════

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# "error" keeps the log file small on shared hosting. Use "debug" only
# while chasing a specific problem, and set it back afterwards.
LOG_LEVEL=error


# ══════════════ DATABASE ══════════════
#
# All four values come from hPanel > Databases > Management, after you
# create a database and a database user there.
#
# Hostinger prefixes both names with your account id, so they look like
# u123456789_pomida and u123456789_pomidauser. Copy them exactly.

DB_CONNECTION=mysql

# On Hostinger shared hosting the database runs on the same machine,
# so this stays as localhost.
DB_HOST=localhost
DB_PORT=3306

DB_DATABASE=FILL_IN_DATABASE_NAME       # hPanel > Databases > Management
DB_USERNAME=FILL_IN_DATABASE_USER       # hPanel > Databases > Management
DB_PASSWORD=FILL_IN_DATABASE_PASSWORD   # the password you set when creating that user


# ══════════════ EMAIL ══════════════
#
# ⚠ THE MOST IMPORTANT SETTING IN THIS FILE IS MAIL_MAILER.
#
# It must be "smtp", never "log".
#
# Two separate things go wrong with "log":
#
#   1. No email is ever delivered, while customers are still told one
#      was sent. Password reset would appear to work and silently never
#      arrive.
#
#   2. If APP_ENV is ALSO left as "local", the password-reset page
#      prints the 6-digit verification code directly on screen. Anyone
#      who knows a staff or admin email address could then take over
#      that account without ever seeing that person's inbox.
#
# php artisan deploy:check tests for both of these by name.

MAIL_MAILER=smtp

# Pick ONE of the two providers below and use all three of its values.
#
#   Hostinger mailbox (hPanel > Emails):
#       MAIL_HOST=smtp.hostinger.com
#       MAIL_PORT=465
#       MAIL_ENCRYPTION=ssl
#
#   Gmail:
#       MAIL_HOST=smtp.gmail.com
#       MAIL_PORT=587
#       MAIL_ENCRYPTION=tls
#     Gmail additionally requires 2-Step Verification to be on, and an
#     "App Password" generated at myaccount.google.com > Security >
#     App passwords. Your normal Gmail password will NOT work here.

MAIL_HOST=FILL_IN_SMTP_HOST             # smtp.hostinger.com  or  smtp.gmail.com
MAIL_PORT=FILL_IN_SMTP_PORT             # 465 for Hostinger,  587 for Gmail
MAIL_ENCRYPTION=FILL_IN_SMTP_ENCRYPTION # ssl for Hostinger,  tls for Gmail

MAIL_USERNAME=FILL_IN_MAILBOX_ADDRESS   # the full email address you are sending from
MAIL_PASSWORD=FILL_IN_MAILBOX_PASSWORD  # hPanel mailbox password, or the Gmail App Password

MAIL_FROM_ADDRESS="FILL_IN_MAILBOX_ADDRESS"  # normally the same as MAIL_USERNAME
MAIL_FROM_NAME="${APP_NAME}"


# ══════════════ FIRST ADMIN ACCOUNT ══════════════
#
# These two create the very first admin login, once, when you run:
#     php artisan db:seed --class=AdminBootstrapSeeder --force
#
# AFTER that admin has logged in successfully, come back and blank both
# lines (leave them empty), then run php artisan config:clear, so a real
# password is not left sitting in a file on the server.

ADMIN_BOOTSTRAP_EMAIL=FILL_IN_ADMIN_EMAIL       # the manager's real email address
ADMIN_BOOTSTRAP_PASSWORD=FILL_IN_ADMIN_PASSWORD # 8+ characters, chosen by the manager
ADMIN_BOOTSTRAP_NAME="Site Admin"


# ══════════════ SESSIONS / CACHE / QUEUE ══════════════
#
# These all use the database, which is the right choice on Hostinger
# shared hosting: there is no Redis and no background worker process.
# Leave them exactly as they are.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local


# ══════════════ MUST STAY OFF ══════════════
#
# Fabricates fake sales history for the analytics charts. It is a demo
# aid for a local machine only. Leave this false.

DEMO_SALES_AUTO_TOPUP=false


# ══════════════ NOT USED BY THIS PROJECT ══════════════
#
# Amazon S3 and Redis are not used. These stay empty so Laravel's config
# files have something to read; do not fill them in.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

# Memcached is not used either; this line exists only so Laravel's cache
# config has a value to read.
MEMCACHED_HOST=127.0.0.1
