        int points_required
        timestamp created_at
        timestamp updated_at
    }
    user_vouchers {
        bigint id PK
        bigint user_id FK "UK with voucher_id"
        bigint issued_by FK
        bigint voucher_id FK "UK with user_id"
        varchar(32) claim_code UK
        date acquired_date
        date valid_from
        tinyint(1) is_used
        timestamp used_at
        timestamp created_at
        timestamp updated_at
    }
    ads {
        bigint id PK
        bigint branch_id FK
        varchar(255) title
        varchar(255) description
