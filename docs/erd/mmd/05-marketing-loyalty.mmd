        varchar(120) title
        varchar(500) message
        timestamp read_at
        timestamp dismissed_at
        timestamp created_at
        timestamp updated_at
    }
    settings {
        bigint id PK
        bigint branch_id FK "UK with key"
        varchar(100) key "UK with branch_id"
        text value
        varchar(50) group
        varchar(255) label
        text description
        enum type
        timestamp created_at
        timestamp updated_at
    }
