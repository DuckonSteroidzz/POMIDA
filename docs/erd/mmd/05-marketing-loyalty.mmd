    }
    free_dessert_ratings {
        bigint id PK
        bigint order_id FK, UK
        bigint order_item_id FK
        bigint user_id FK
        tinyint rating
        text comment
        timestamp created_at
        timestamp updated_at
    }
    order_ratings {
        bigint id PK
        bigint order_id FK, UK
        bigint user_id FK
        varchar(20) rating_type
