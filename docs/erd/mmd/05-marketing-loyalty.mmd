        enum placement
        tinyint(1) is_active
        int display_order
        timestamp starts_at
        timestamp ends_at
        timestamp created_at
        timestamp updated_at
    }
    games_played {
        bigint id PK
        bigint user_id FK
        bigint order_id FK
        tinyint spin_number
        smallint points_awarded
        timestamp created_at
        timestamp updated_at
    }
    loyalty_awards {
        bigint id PK
        bigint user_id FK "UK with type, award_key"
        varchar(32) type "UK with user_id, award_key"
