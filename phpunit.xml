<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Hard isolation from the dev database, added 2026-09-14 after
            RefreshDatabase's migrate:fresh wiped pomida_db: this file had NO
            override here (both lines below were commented out) and no
            .env.testing existed, so every test run migrated the SAME
            database `php artisan serve` uses. pomida_db_testing is a
            dedicated, empty MySQL database (same server/credentials, just a
            different name) that only the test suite ever touches — kept on
            MySQL rather than switched to sqlite so tests that rely on
            MySQL-specific SQL keep working unchanged.
        -->
        <env name="DB_DATABASE" value="pomida_db_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
